# Copy this file to .env and fill in your keys

PORT=3000
# Public URL of the site once hosted (used in SMS links and Paystack callback)
BASE_URL=http://localhost:3000

# Password for the owner dashboard at /admin
ADMIN_KEY=change-me-to-a-strong-password

BUSINESS_NAME=LMJ
PRODUCT_NAME=LMJ Surface Disinfectant (Pink Blossom, 100ml)
PRODUCT_PRICE=25
DELIVERY_FEE=0

# Owner's number – receives all orders by SMS + WhatsApp
OWNER_PHONE=0535623533

# mNotify (https://mnotify.com) – SMS to owner and customers
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=LMJ

# Paystack (https://dashboard.paystack.com) – online payment
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Optional: WhatsApp Business Cloud API (Meta). Leave blank to use wa.me links instead.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
